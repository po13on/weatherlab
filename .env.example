OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4.1-flash

# off | manual | eval_skip
HITL_MODE=eval_skip

# sqlite (default, no Docker) | postgres
STORAGE=sqlite
DATABASE_URL=postgresql://weatherlab:weatherlab@127.0.0.1:5432/weatherlab

# empty = in-memory four-use semantics; set after `docker compose up -d`
REDIS_URL=
